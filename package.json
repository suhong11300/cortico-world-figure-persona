{
  "name": "cortico-world-figure-persona",
  "version": "0.2.1",
  "type": "module",
  "description": "给 Coopanion 形象包挂上多档人设：一个形象几档人格，一键切换，形象包更新不冲掉",
  "license": "MIT",
  "author": "苏鸿与维基 (suhong11300)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhong11300/cortico-world-figure-persona.git"
  },
  "homepage": "https://github.com/suhong11300/cortico-world-figure-persona#readme",
  "bugs": {
    "url": "https://github.com/suhong11300/cortico-world-figure-persona/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "desktop-pet",
    "figure-pack",
    "persona",
    "persona-profiles",
    "system-prompt"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "webUiClient": "dist/webui.js",
    "tags": [
      "companion",
      "internal-state"
    ],
    "describe": "describe.json",
    "displayName": "形象人格",
    "icon": "icon.svg",
    "locales": {
      "zh": {
        "displayName": "形象人格",
        "description": "给一个形象挂多档人设:切换人设不用重装形象包,形象包更新也不冲掉你写的人格。"
      },
      "en": {
        "displayName": "Figure Persona",
        "description": "Several personas per figure: switch without touching the figure pack, and keep your wording when the pack updates."
      }
    }
  },
  "files": [
    "src",
    "icon.svg",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "prepublishOnly": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "describe": "tsx scripts/describe.mts",
    "describe:check": "tsx scripts/describe.mts --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
