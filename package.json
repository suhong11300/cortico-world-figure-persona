{
  "name": "cortico-world-figure-persona",
  "version": "0.2.3",
  "type": "module",
  "description": "为一个形象挂载多档人设。切换无需重装形象包；人设独立存储，更新形象不覆盖；切换后即时生效。",
  "license": "MIT",
  "author": "苏鸿与维基 (suhong11300)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhong11300/cortico-world-figure-persona.git"
  },
  "homepage": "https://github.com/suhong11300/cortico-world-figure-persona#readme",
  "bugs": {
    "url": "https://github.com/suhong11300/cortico-world-figure-persona/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "desktop-pet",
    "figure-pack",
    "persona",
    "persona-profiles",
    "system-prompt",
    "persona-switch",
    "figure-json"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "webUiClient": "dist/webui.js",
    "tags": [
      "companion",
      "internal-state"
    ],
    "describe": "describe.json",
    "displayName": "形象人格",
    "icon": "icon.svg",
    "locales": {
      "zh": {
        "displayName": "形象人格",
        "description": "为一个形象挂载多档人设。切换无需重装形象包；人设独立存储，更新形象不覆盖；切换后即时生效。"
      },
      "en": {
        "displayName": "Figure Persona",
        "description": "Attaches multiple personas to a single figure. Switching needs no reinstall; personas are stored outside the figure pack and survive pack updates; changes take effect immediately."
      }
    }
  },
  "files": [
    "src",
    "icon.svg",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "prepublishOnly": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "describe": "tsx scripts/describe.mts",
    "describe:check": "tsx scripts/describe.mts --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
