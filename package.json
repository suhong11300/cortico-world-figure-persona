{
  "name": "cortico-world-figure-persona",
  "version": "0.1.0",
  "type": "module",
  "description": "给 Coopanion 形象包绑定人格：把当前形象的人格注入环境提示词",
  "license": "MIT",
  "author": "苏鸿与维基 (suhong11300)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhong11300/cortico-world-figure-persona.git"
  },
  "homepage": "https://github.com/suhong11300/cortico-world-figure-persona#readme",
  "bugs": {
    "url": "https://github.com/suhong11300/cortico-world-figure-persona/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "desktop-pet",
    "figure-pack",
    "persona",
    "system-prompt"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.6",
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "webUiClient": "dist/webui.js",
    "tags": [
      "external-setup",
      "experimental"
    ],
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "describe.json"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "prepublishOnly": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
